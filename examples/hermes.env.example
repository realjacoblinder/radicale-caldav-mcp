# Add to the active Hermes profile's .env, not config.yaml.
PERSONAL_CALDAV_USERNAME=alice
PERSONAL_CALDAV_PASSWORD=REPLACE_WITH_ALICES_PASSWORD
FAMILY_CALDAV_USERNAME=family
FAMILY_CALDAV_PASSWORD=REPLACE_WITH_FAMILY_PASSWORD
# For the partner's profile, PERSONAL_CALDAV_USERNAME=partner and use her password.
# Each profile receives the same family identity if shared access is desired.
