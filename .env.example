# Process configuration for a direct CLI launch. The server does not auto-load .env.
CALDAV_URL=http://127.0.0.1:5232
CALDAV_USERNAME=jake
CALDAV_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
CALDAV_VERIFY_SSL=true
CALDAV_TIMEOUT=30
CALDAV_DEFAULT_TIMEZONE=America/New_York
CALDAV_MAX_RANGE_DAYS=93
CALDAV_MAX_EVENTS=5000
LOG_LEVEL=WARNING
